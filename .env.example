# Open Vote Next.js 환경 변수 설정 템플릿
# 이 파일을 복사하여 .env.local 또는 .env.production 으로 사용하세요.
# 절대 Git 에 커밋하지 마세요!

# Supabase 프로젝트 URL
# 예: https://xxxxx.supabase.co
SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Supabase Anon Key (공개 키 - 클라이언트용)
# Settings → API → Project API keys → anon/public
SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 새 Supabase API 키 체계를 쓰는 경우 위 ANON 대신 publishable key 사용 가능
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase Service Role Key (비밀 키 - 서버/Edge Function 용)
# Settings → API → Project API keys → service_role
# ⚠️ 이 키는 절대 클라이언트 코드에 노출하면 안 됩니다!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------
# simply-notifier (투표 링크 SMS 발송 서버)
# 관리 웹(https://notifier.bluerdot.net/admin)에서 앱 등록 후 발급받은 값.
# 템플릿은 {name}, {url} 변수를 사용해야 합니다.
#   예: "[{app_name}] {name}님, 투표에 참여해주세요: {url}"
# ⚠️ API_SECRET은 서버 전용입니다. 클라이언트에 노출 금지!
# -----------------------------------------------------
SIMPLY_NOTIFIER_BASE_URL=https://notifier.bluerdot.net
SIMPLY_NOTIFIER_APP_ID=app_xxxxxxxxxxxx
SIMPLY_NOTIFIER_API_SECRET=smsk_xxxxxxxxxxxx
SIMPLY_NOTIFIER_TEMPLATE=투표안내

# 문자에 들어갈 투표 링크의 기준 URL (미설정 시 요청 origin 사용)
# 예: https://vote.example.com  →  링크는 https://vote.example.com/v/<토큰>
VOTE_LINK_BASE_URL=

# 투표 생성 과금: 유권자 1인당 차감 포인트 (기본 10 = 10원 상당)
VOTE_CREDIT_PER_VOTER=10

# 선택사항: 앱 설정
APP_NAME=Open Vote
APP_VERSION=1.0.0

# 선택사항: 기능 플래그
ENABLE_REALTIME=true
ENABLE_RATE_LIMITING=true

# nozolink 연동 / 핸드오프
# OPENVOTE_HANDOFF_SECRET: nozolink와 반드시 동일한 값(핸드오프 state HMAC 서명 검증).
OPENVOTE_HANDOFF_SECRET=

# 문자 발송(중요 안건 sms_token) — Simply-Notifier
# 템플릿 "투표안내" 는 변수 {name}, {url} 을 사용. 관리 웹에서 사전 등록 필요.
SIMPLY_NOTIFIER_BASE_URL=https://notifier.bluerdot.net
SIMPLY_NOTIFIER_APP_ID=openvote
SIMPLY_NOTIFIER_API_SECRET=
SIMPLY_NOTIFIER_TEMPLATE=투표안내
SIMPLY_NOTIFIER_DRY_RUN=
VOTE_LINK_BASE_URL=https://openvote.bluerdot.net
NEXT_PUBLIC_SITE_URL=https://openvote.bluerdot.net
