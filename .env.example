# Open Vote Next.js 환경 변수 설정 템플릿
# 이 파일을 복사하여 .env.local 또는 .env.production 으로 사용하세요.
# 절대 Git 에 커밋하지 마세요!

# Supabase 프로젝트 URL
# 예: https://xxxxx.supabase.co
SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Supabase Anon Key (공개 키 - 클라이언트용)
# Settings → API → Project API keys → anon/public
SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 새 Supabase API 키 체계를 쓰는 경우 위 ANON 대신 publishable key 사용 가능
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase Service Role Key (비밀 키 - 서버/Edge Function 용)
# Settings → API → Project API keys → service_role
# ⚠️ 이 키는 절대 클라이언트 코드에 노출하면 안 됩니다!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 선택사항: 앱 설정
APP_NAME=Open Vote
APP_VERSION=1.0.0

# 선택사항: 기능 플래그
ENABLE_REALTIME=true
ENABLE_RATE_LIMITING=true

# nozolink 연동 / 핸드오프
# OPENVOTE_HANDOFF_SECRET: nozolink와 반드시 동일한 값(핸드오프 state HMAC 서명 검증).
OPENVOTE_HANDOFF_SECRET=

# 문자 발송(중요 안건 sms_token) — Simply-Notifier
# 템플릿 "투표안내" 는 변수 {name}, {url} 을 사용. 관리 웹에서 사전 등록 필요.
SIMPLY_NOTIFIER_BASE_URL=https://notifier.bluerdot.net
SIMPLY_NOTIFIER_APP_ID=openvote
SIMPLY_NOTIFIER_API_SECRET=
SIMPLY_NOTIFIER_TEMPLATE=투표안내
SIMPLY_NOTIFIER_DRY_RUN=
VOTE_LINK_BASE_URL=https://openvote.bluerdot.net
NEXT_PUBLIC_SITE_URL=https://openvote.bluerdot.net
